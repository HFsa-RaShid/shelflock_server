datasource db {
  provider = "postgresql"

}

generator client {
  provider = "prisma-client-js"
}

enum Status {
  Active
  Inactive
}

model Merchant {
  id        String   @id @default(uuid())
  name      String
  email     String   @unique
  password  String
  createdAt DateTime @default(now())
  stores    Store[]
}

model Store {
  id         String      @id @default(uuid())
  name       String
  phone      String
  createdAt  DateTime    @default(now())
  merchantId String
  merchant   Merchant    @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  products   Product[]
  categories Category[]
  alertRule  AlertRule?

  @@index([merchantId])
}

model Category {
  id          String    @id @default(uuid())
  name        String
  description String?   @default("")
  status      Status    @default(Active)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  storeId     String
  store       Store     @relation(fields: [storeId], references: [id], onDelete: Cascade)
  products    Product[]

  @@unique([name, storeId])
  @@index([storeId])
  @@map("categories")
}

model Product {
  id              String    @id @default(uuid())
  title           String
  quantity        Int
  lotNumber       String?
  expiryDate      DateTime
  alertDaysBefore Int       @default(7)
  lastAlertedDay  Int?      // 👈 মাল্টিপল অ্যালার্ট ট্র্যাক করার জন্য (যেমন: ৩০ দিন আগে অ্যালার্ট পাঠানো হলে এখানে ৩০ সেভ হবে)
  createdAt       DateTime  @default(now())
  storeId         String?
  store           Store?    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  categoryId      String?
  category        Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  @@index([storeId])    
  @@index([categoryId]) 
}

model AlertRule {
  id              String   @id @default(uuid())
  storeId         String   @unique
  store           Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  intervals       Int[]    // ফ্রন্টএন্ডের সিলেক্ট করা দিনগুলো যেমন: [30, 7, 3]
  customMessage   String   // কাস্টম মেসেজ টেমপ্লেট
  whatsappNumber  String?  // 👈 ফ্রন্টএন্ড থেকে পাঠানো ডায়নামিক নম্বর ("88018XXXXXXXX")
  channels        String[] // ["In-App Notification", "Email Dispatch", "WhatsApp Alert"]
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}